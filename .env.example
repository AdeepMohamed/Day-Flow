# PeopleOS Environment Variables
# Copy this to .env.local and fill in real values

# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# Get from: https://console.neon.tech → your project → Connection Details
DATABASE_URL="postgresql://user:pass@host/peopleos?sslmode=require"
DIRECT_URL="postgresql://user:pass@host/peopleos?sslmode=require"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here-minimum-32-characters-long"

# ─── Grok AI (xAI) ───────────────────────────────────────────────────────────
# Get from: https://console.x.ai
XAI_API_KEY="xai-your-api-key-here"
XAI_MODEL="grok-3-mini"

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Get from: https://resend.com/api-keys
RESEND_API_KEY="re_your-resend-api-key"
RESEND_FROM_EMAIL="noreply@peopleos.app"

# ─── Cloudinary (File Uploads) ───────────────────────────────────────────────
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
